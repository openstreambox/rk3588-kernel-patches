diff --git a/arch/arm64/boot/dts/rockchip/rk3588-rock-5b-plus.dts b/arch/arm64/boot/dts/rockchip/rk3588-rock-5b-plus.dts
--- a/arch/arm64/boot/dts/rockchip/rk3588-rock-5b-plus.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3588-rock-5b-plus.dts
@@ -36,8 +36,18 @@
 		pinctrl-names = "default";
 		pinctrl-0 = <&wwan_power_en>;
 		regulator-name = "vcc3v3_wwan_pwr";
+		/*
+		 * The bootloader may already have powered the card while
+		 * RESET# was not yet driven; some cards then start in their
+		 * bootloader instead of their firmware. Without boot-on, the
+		 * enable GPIO is requested low, which switches the card off
+		 * through FULL_CARD_POWER_OFF# while 3.3 V stays applied. The
+		 * always-on enable then waits for off-on-delay-us from boot,
+		 * so the card starts cleanly after the RESET# hog in &gpio2
+		 * has released reset.
+		 */
 		regulator-always-on;
-		regulator-boot-on;
+		off-on-delay-us = <4000000>;
 		regulator-min-microvolt = <3300000>;
 		regulator-max-microvolt = <3300000>;
 		vin-supply = <&vcc3v3_4g>;
